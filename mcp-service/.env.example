# Copy to mcp-service/.env. Use shared storage settings across the web app and every MCP replica.
MCP_HOST=127.0.0.1
MCP_PORT=3100
# Browser origins allowed to call MCP; comma-separated. Non-browser clients omit Origin.
MCP_ALLOWED_ORIGINS=
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
DYNAMODB_REGION=us-east-1
DYNAMODB_TABLE=Snap
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=snap-skills
S3_ACCESS_KEY=snaplocal
S3_SECRET_KEY=snaplocalpassword
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_CLEF_MODEL=@cf/cloudflare/clef-flash
ROUTING_PROVIDER=cloudflare
LOCAL_SYSTEMONE_URL=
LOCAL_SYSTEMONE_MODEL=Cloudflare/clef-flash
LOCAL_SYSTEMONE_API_KEY=
SKILL_MATCH_THRESHOLD=0.42
