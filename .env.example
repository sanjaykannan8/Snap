# Local DynamoDB
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
DYNAMODB_REGION=us-east-1
DYNAMODB_TABLE=Snap

# Local MinIO (change credentials for any non-local deployment)
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=snap-skills
S3_ACCESS_KEY=snaplocal
S3_SECRET_KEY=snaplocalpassword

# Use a randomly generated value of at least 32 characters in development and production.
JWT_SECRET=replace-with-a-long-random-secret-before-production
# Local HTTP: false. Set true when the dashboard is served over HTTPS.
SESSION_COOKIE_SECURE=false
# Optional exact external dashboard origin, e.g. https://snap.example.com behind a reverse proxy.
APP_ORIGIN=

# Choose cloudflare or local (System One-compatible /v1/systemone endpoint).
ROUTING_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_CLEF_MODEL=@cf/cloudflare/clef-flash
LOCAL_SYSTEMONE_URL=
LOCAL_SYSTEMONE_MODEL=Cloudflare/clef-flash
LOCAL_SYSTEMONE_API_KEY=
SKILL_MATCH_THRESHOLD=0.42

# Independent MCP service; set MCP_PUBLIC_URL to its public HTTPS endpoint in production.
MCP_HOST=127.0.0.1
MCP_PORT=3100
MCP_ALLOWED_ORIGINS=
MCP_PUBLIC_URL=http://127.0.0.1:3100/mcp

# Compose host bindings. Use 0.0.0.0 to listen on network interfaces.
WEB_BIND_ADDRESS=127.0.0.1
MCP_BIND_ADDRESS=127.0.0.1
S3_BIND_ADDRESS=127.0.0.1
